+    let tx = db.transaction()?;
+    if tx.execute("UPDATE users SET disabled=1 WHERE id=?", [&id])? == 0 {
+        return Err(missing());
+    }
+    let revoked = tx.execute("DELETE FROM sessions WHERE user_id=?", [&id])?;
+    tx.commit()?;
+    Ok(Json(
+        json!({"ok":true,"disabled":true,"sessions_revoked":revoked}),
+    ))
