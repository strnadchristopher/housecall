# Copy to .env and set secrets before starting Compose. Do not commit .env.
CHRISCORD_SETUP_TOKEN=
CHRISCORD_MEDIA_KEY=
CHRISCORD_DATA_DIR=./data

# Caddy and the app container must share this external Docker network.
LO_PROXY_NETWORK=lo-proxy
CHRISCORD_PORT=4317
CHRISCORD_ORIGIN=https://chriscord.littleobelisk.com
CHRISCORD_PUBLIC_URL=https://chriscord.littleobelisk.com
# Tauri production origins: macOS/Linux use tauri://localhost; Windows/Android use http://tauri.localhost.
CHRISCORD_CLIENT_ORIGINS=tauri://localhost,http://tauri.localhost

# Email invitations use Resend. With no key, invite links are logged for local development.
RESEND_API_KEY=
CHRISCORD_MAIL_FROM=

# WebRTC media bypasses Caddy. Allow this UDP port through the host firewall/router.
SFU_HOST_BIND=0.0.0.0
SFU_PUBLIC_IP=
SFU_PORT=50000

CHRISCORD_MEDIA_SCANNER=clamav
CHRISCORD_SCAN_TIMEOUT_SECONDS=300
GIPHY_API_KEY=
PLEX_URL=
PLEX_TOKEN=
GIMME_BASE_URL=https://api.littleobelisk.com
GIMME_AGENT_API_KEY=
GIMME_DRY_RUN=true
SWITCHBOARD_URL=https://switchboard.littleobelisk.com/v1/chat/completions
SWITCHBOARD_API_KEY=
DJ_ENABLED=false
PUSH_ENABLED=false
