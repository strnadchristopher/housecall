# EXAMPLE ONLY. Hosted client assets are a separate build; chat servers release separately.
{
    admin off
    log default {
        output discard
    }
}

www.housecall.chat {
    redir https://housecall.chat{uri} permanent
}

housecall.chat {
    # Deliberately no access-log directive. Global output discard also prevents
    # proxy error events from durably recording request IP/UA/URI metadata.
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    @landing not path /api/directory /api/directory/*
    header @landing {
        Cache-Control "no-cache"
        Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'"
    }
    @portal path /api/directory /api/directory/*
    header @portal {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Cache-Control "no-store"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'"
    }
    @accountAPI path /api/directory /api/directory/*
    handle @accountAPI {
        request_body {
            max_size 96KB
        }
        reverse_proxy 127.0.0.1:43180 {
            # Backend trusts only this explicit loopback proxy, never the client's
            # submitted forwarding chain. Do not enable another ingress without review.
            header_up X-Forwarded-For {remote_host}
            transport http {
                dial_timeout 2s
                response_header_timeout 12s
            }
        }
    }
    @oldApp path /app /app/*
    redir @oldApp https://app.housecall.chat/ 302
    handle_path /source/* {
        root * /srv/housecall/current/source
        file_server
    }
    handle /privacy {
        root * /srv/housecall/current/website
        rewrite * /privacy.html
        file_server
    }
    handle {
        root * /srv/housecall/current/website
        file_server
    }
}

app.housecall.chat {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Cache-Control "no-store"
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
        Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https: wss:; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' https:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
    }
    @accountAPI path /api/account /api/account/* /api/directory /api/directory/*
    handle @accountAPI {
        request_body {
            max_size 96KB
        }
        reverse_proxy 127.0.0.1:43180 {
            # Backend trusts only this explicit loopback proxy, never the client's
            # submitted forwarding chain. Do not enable another ingress without review.
            header_up X-Forwarded-For {remote_host}
            transport http {
                dial_timeout 2s
                response_header_timeout 12s
            }
        }
    }
    handle {
        root * /srv/housecall/current/client/dist-hosted
        file_server
    }
}
