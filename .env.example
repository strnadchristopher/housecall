# Run python3 scripts/init-env.py to create .env with random secrets, then set the origin below.
HOUSECALL_SETUP_TOKEN=
HOUSECALL_MEDIA_KEY=
# Required. The public origin people use to reach Housecall, with no trailing path.
# Used for passkeys (WebAuthn origin) and invite links.
HOUSECALL_PUBLIC_URL=https://chat.example.com
HOUSECALL_MAIL_FROM=
RESEND_API_KEY=
# Default Compose image includes the ClamAV socket client. WithSecure needs separately
# provisioned licensed engine/runtime; see docs/WHOLE-OBJECT-SCANNER.md.
HOUSECALL_MEDIA_SCANNER=clamav
HOUSECALL_FSANALYZE=
HOUSECALL_SCAN_TIMEOUT_SECONDS=300
HOUSECALL_ORIGIN=https://chat.example.com
HOUSECALL_PORT=4317
HOUSECALL_DATA_DIR=./data
# Explicit native origin allowlist; no wildcard.
HOUSECALL_CLIENT_ORIGINS=
# Explicit Android app signing origins: android:apk-key-hash:<SHA256 base64url>.
# Empty keeps native Android passkeys unavailable; never trust a caller-supplied origin.
HOUSECALL_ANDROID_PASSKEY_ORIGINS=
# Voice/video media is UDP and does not pass through your HTTPS reverse proxy. Open SFU_PORT/udp
# on the host firewall and set SFU_PUBLIC_IP to the address clients can reach (numeric IPv4).
# SFU_HOST_BIND=0.0.0.0 publishes the port on all interfaces. There is no TURN relay, so
# networks that block direct UDP may not connect voice or video.
SFU_HOST_BIND=127.0.0.1
SFU_PUBLIC_IP=127.0.0.1
SFU_PORT=50000
GIPHY_API_KEY=
PLEX_URL=
PLEX_TOKEN=
# Optional integrations: leave the URLs empty and the integration stays disabled.
GIMME_BASE_URL=
GIMME_AGENT_API_KEY=
GIMME_DRY_RUN=true
SWITCHBOARD_URL=
SWITCHBOARD_API_KEY=
# Empty selects local placeholder; no hosted voice clone is supported.
DJ_TTS_COMMAND=
DJ_REFERENCE_AUDIO=
PUSH_ENABLED=false
# A separate random32-byte hex key encrypts push device tokens in SQLite.
PUSH_TOKEN_KEY=
APNS_PRIVATE_KEY_PEM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_SANDBOX=false
FCM_SERVICE_ACCOUNT_JSON=
GLUETUN_CONTAINER=gluetun
VM_MEMORY_MB=2048
VM_CPUS=2

# VM profile: reserve UID47191 in shared Gluetun namespace; see docs/VM.md.
VM_KVM_GID=109
VM_TUNNEL_INTERFACE=tun0
# Optional app input gateway; Unix socket only, bound to one explicit channel.
# HOUSECALL_VM_QMP_SOCKET=/control/qmp.sock
# HOUSECALL_VM_CHANNEL_ID=general

# Optional private VM media overlay; no public capture/bootstrap endpoint.
# HOUSECALL_VM_MEDIA_SOCKET=/signaling/publisher.sock
# HOUSECALL_VM_MEDIA_UID=47192

# Optional private QEMU supervisor; required for authenticated offline reset.
# HOUSECALL_VM_SUPERVISOR_SOCKET=/control/supervisor.sock

# Desktop apps: set HOUSECALL_CLIENT_ORIGINS=tauri://localhost,http://tauri.localhost above.

# Setup: HOUSECALL_SETUP_TOKEN creates the first owner once through /api/setup. Remove it from
# .env afterwards; the app starts without it once initialized.
#
# Existing reverse proxy on a Docker network? Set HOUSECALL_PROXY_NETWORK and start with
#   docker compose -f compose.yaml -f compose.proxy.yaml up -d
# then point the proxy at http://housecall:3000 (WebSocket upgrades are fine; events use HTTP).
# HOUSECALL_PROXY_NETWORK=
#
# Email invitations are optional: with no RESEND_API_KEY the invite response still returns a
# link to share yourself.
