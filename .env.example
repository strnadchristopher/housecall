# Run python3 scripts/init-env.py to create private random local secrets.
CHRISCORD_SETUP_TOKEN=
CHRISCORD_MEDIA_KEY=
CHRISCORD_ORIGIN=http://localhost:4317
CHRISCORD_PORT=4317
# Explicit native origin allowlist; no wildcard.
CHRISCORD_CLIENT_ORIGINS=
# UDP is separate from Caddy HTTPS; select LAN/Tailscale/public address deliberately.
SFU_HOST_BIND=127.0.0.1
SFU_PUBLIC_IP=127.0.0.1
SFU_PORT=50000
GIPHY_API_KEY=
PLEX_URL=
PLEX_TOKEN=
GIMME_BASE_URL=https://api.littleobelisk.com
GIMME_AGENT_API_KEY=
GIMME_DRY_RUN=true
SWITCHBOARD_URL=https://switchboard.littleobelisk.com/v1/chat/completions
SWITCHBOARD_API_KEY=
# Empty selects local placeholder; no hosted voice clone is supported.
DJ_TTS_COMMAND=
DJ_REFERENCE_AUDIO=
PUSH_ENABLED=false
# A separate random32-byte hex key encrypts push device tokens in SQLite.
PUSH_TOKEN_KEY=
APNS_PRIVATE_KEY_PEM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_SANDBOX=false
FCM_SERVICE_ACCOUNT_JSON=
GLUETUN_CONTAINER=gluetun
VM_MEMORY_MB=2048
VM_CPUS=2

# VM profile: reserve UID47191 in shared Gluetun namespace; see docs/VM.md.
VM_KVM_GID=109
VM_TUNNEL_INTERFACE=tun0
